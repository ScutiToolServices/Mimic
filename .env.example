# Copy to .env (git-ignored). run.bat loads it for a local run (--dotenv, names only are printed); Docker compose reads it from this folder; a real environment variable wins. Never commit real credentials.
# Start-up values only. Limits, timeout and ffmpeg are settings: change them on the admin page (/admin/); a saved value beats .env.
SERVICE_HOST=127.0.0.1
SERVICE_PORT=29404
# Docker published bind; container itself always binds 0.0.0.0.
SERVICE_BIND=127.0.0.1
# Unlocks /admin/ and turns token checks on for /mcp and /api. Create one token per caller (Armory, other services) on the page
# and give each caller its own. Required when SERVICE_HOST is not loopback; empty = no page and no checks (loopback only).
SERVICE_ADMIN_PASSWORD=
# Model service addresses and tokens are not set here: save them as connections on the admin page (/admin/).
# TTS_Kitten2_Model admin password, used only for voice upload/delete. Environment only.
SERVICE_KITTEN2_ADMIN_PASSWORD=
# Optional second model, TTS_Audio8_Model (GPU): choose it per voice with model=audio8 when cloning.
# SERVICE_AUDIO8_ADMIN_PASSWORD=
