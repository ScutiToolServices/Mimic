# Copy to .env (git-ignored). run.bat loads it for a local run (--dotenv, names only are printed); Docker compose reads it from this folder; a real environment variable wins. Never commit real credentials.
# Start-up values only. Limits, timeout and ffmpeg are settings: change them on the admin page (/admin/); a saved value beats .env.
INTERNAL_API_TOKEN=
MIMIC_HOST=127.0.0.1
MIMIC_PORT=8094
# Docker published bind; container itself always binds 0.0.0.0.
MIMIC_BIND=127.0.0.1
# Unlocks /admin/ (settings, saved model connections, usage). Empty = page off.
MIMIC_ADMIN_PASSWORD=
# Model service addresses and tokens are not set here: save them as connections on the admin page (/admin/).
# Model service KITTEN2_ADMIN_PASSWORD, used only for voice upload/delete. Environment only.
MIMIC_KITTEN2_ADMIN_PASSWORD=
# Optional second model, TTSAudio8Model (GPU): choose it per voice with model=audio8 when cloning.
# MIMIC_AUDIO8_ADMIN_PASSWORD=
